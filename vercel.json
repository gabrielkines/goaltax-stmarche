{
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/login",  "destination": "/login.html"  },
    { "source": "/logout", "destination": "/logout.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }
      ]
    }
  ]
}
